{
  "name": "edugames-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:context-audio": "node scripts/generateContextGapAudio.mjs",
    "generate:lantern-audio": "node scripts/generateLanternSounds.mjs",
    "generate:scramble-audio": "node scripts/generateSentenceScrambleAudio.mjs",
    "test": "npm run test:audio && npm run build",
    "test:audio": "node scripts/testLanternSounds.mjs && node scripts/testMandarinAudio.mjs && node scripts/testContextGapAudio.mjs && node scripts/testSentenceScrambleAudio.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "phaser": "^4.2.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
